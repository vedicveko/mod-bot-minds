[worldserver]

########################################
# mod-bot-minds
#
# Playerbots that talk like people: one persona per bot, a memory that survives
# restarts, and one pipeline for every line they say (replies, idle chatter and
# reactions to what happens around them).
#
# Hosted providers need an API key. A local Ollama endpoint does not.
########################################

# BotMinds.Enable
#     Description: Master switch for the module.
#     Default:     1
BotMinds.Enable = 1

# BotMinds.DebugEnabled
#     Description: Log who was picked to answer, who stayed quiet, and why.
#     Default:     0
BotMinds.DebugEnabled = 0

# BotMinds.DebugShowFullPrompt
#     Description: Also log the full prompt sent for each line. Very noisy.
#     Default:     0
BotMinds.DebugShowFullPrompt = 0

########################################
# Provider
########################################

# BotMinds.Provider
#     Description: "anthropic", "openai" or "ollama". All need tool calling,
#                  which the memory and action systems depend on.
#
#                  Anthropic is the tested path. The OpenAI provider is wired up
#                  but has never had a call made through it; if you select it and
#                  bots stay silent, the server log will carry the API's own
#                  error text. Ollama supports both a local server and direct
#                  Ollama Cloud access through BotMinds.Url.
#     Default:     "anthropic"
BotMinds.Provider = "anthropic"

# BotMinds.ApiKey
#     Description: API key for the provider. May be empty for local Ollama or
#                  when BotMinds.ApiKeyEnv names an environment variable.
#     Default:     ""
BotMinds.ApiKey = ""

# BotMinds.ApiKeyEnv
#     Description: Optional environment variable containing the provider API
#                  key. Useful for keeping hosted-provider secrets out of this
#                  file. For direct Ollama Cloud access, use "OLLAMA_API_KEY".
#     Default:     ""
BotMinds.ApiKeyEnv = ""

# BotMinds.Model
#     Default:     "claude-haiku-4-5"
BotMinds.Model = "claude-haiku-4-5"

# BotMinds.Url
#     Description: Ollama chat endpoint. Ignored by Anthropic and OpenAI.
#                  Local:  http://localhost:11434/api/chat
#                  Cloud:  https://ollama.com/api/chat
#     Default:     "http://localhost:11434/api/chat"
BotMinds.Url = "http://localhost:11434/api/chat"

# BotMinds.MaxTokens
#     Default:     512
BotMinds.MaxTokens = 512

# BotMinds.TimeoutSec
#     Default:     30
BotMinds.TimeoutSec = 30

# BotMinds.MaxReplyChars
#     Description: Hard limit on a spoken line. The model is told this number and
#                  anything longer is trimmed back to a sentence or word boundary.
#     Default:     200
BotMinds.MaxReplyChars = 200

# BotMinds.Response.StripMarkdown
# BotMinds.Response.StripDecorativeUnicode
#     Description: Remove formatting, emoji and other decoration that does not
#                  render naturally in the 3.3.5 chat client. Smart punctuation
#                  is folded to ASCII and accented Latin letters are preserved.
#     Default:     1
BotMinds.Response.StripMarkdown = 1
BotMinds.Response.StripDecorativeUnicode = 1

# BotMinds.WorkerThreads
#     Description: Managed HTTP workers. Keep this at least as large as
#                  Limits.MaxConcurrentCalls. Changes take effect after restart.
#     Default:     3
BotMinds.WorkerThreads = 3

# BotMinds.MaxQueueDepth
#     Description: Maximum requests waiting for a worker. 0 is unlimited.
#                  Completed replies waiting for a typing delay are separate.
#     Default:     64
BotMinds.MaxQueueDepth = 64

########################################
# Which channels bots listen to
########################################

BotMinds.Route.HandleWhispers = 1
BotMinds.Route.HandleSay      = 1
BotMinds.Route.HandleParty    = 1
BotMinds.Route.HandleGuild    = 1

# BotMinds.Route.HandleChannel
#     Description: General, Trade and other numbered channels. Off by default;
#                  a busy channel burns calls quickly.
#     Default:     0
BotMinds.Route.HandleChannel = 0

########################################
# Who answers
#
# Reply chance is applied once, here. A named bot always answers, and so does
# whoever spoke last (see FloorWindowSec), so these only decide how likely an
# uninvolved bystander is to pick up an open remark.
########################################

BotMinds.ReplyChance.Whisper  = 100
BotMinds.ReplyChance.Say      = 70
BotMinds.ReplyChance.Party    = 85
BotMinds.ReplyChance.Guild    = 50
BotMinds.ReplyChance.Channel  = 35

# BotMinds.ReplyChance.BotToBot
#     Description: Chance a bot picks up on another bot's line. Only ever happens
#                  where a real player can see it.
#     Default:     12
BotMinds.ReplyChance.BotToBot = 12

# BotMinds.Attention.FloorWindowSec
#     Description: How long after speaking a bot keeps the right to answer you.
#                  Inside this window your next message goes to that bot alone,
#                  unless you name someone else or address the room ("hey folks",
#                  "does anyone...").
#     Default:     60
BotMinds.Attention.FloorWindowSec = 60

# BotMinds.Attention.InterjectChance
#     Description: Chance a bystander chips in while someone else holds the floor.
#     Default:     12
BotMinds.Attention.InterjectChance = 12

# BotMinds.Attention.SmallGroupSize
#     Description: With this many bots listening or fewer, one of them always
#                  answers you. Stops a two-man party ignoring you.
#     Default:     3
BotMinds.Attention.SmallGroupSize = 3

# BotMinds.Attention.MaxBotsToPick
#     Description: Most bots that may answer a single line.
#     Default:     2
BotMinds.Attention.MaxBotsToPick = 2

# BotMinds.Attention.MaxBotChainDepth
#     Description: How far a bot-to-bot exchange may run after something a human
#                  said. 0 stops bots answering each other entirely.
#     Default:     2
BotMinds.Attention.MaxBotChainDepth = 2

# BotMinds.SayDistance
#     Description: Earshot in yards. This is the one distance that governs
#                  everything spoken out loud: which bots can hear your say or
#                  yell, whether a bot's own say has anyone to hear it, and how
#                  near a person must be before a bot speaks unprompted.
#
#                  It doubles as how far a bot looks around for something to
#                  remark on, so raising it also makes bots notice things further
#                  away.
#     Default:     30.0
BotMinds.SayDistance = 30.0

########################################
# Conversation transcript
#
# The recent chat every bot in a scope can see. This is what lets a bot know your
# "yeah good thanks, you?" was aimed at whoever just asked.
########################################

BotMinds.Transcript.Lines    = 8
BotMinds.Transcript.MaxChars = 700

# BotMinds.Transcript.TtlSec
#     Description: Forget a conversation after this long with nothing said.
#     Default:     900
BotMinds.Transcript.TtlSec = 900

########################################
# Memory
#
# Written to mod_bot_minds_memory as it happens, so a hard restart loses nothing.
# Inspect it in game with `.botminds memory <bot>`.
########################################

BotMinds.Memory.RecentCount    = 6
BotMinds.Memory.RelevantCount  = 4
BotMinds.Memory.MaxPerSubject  = 30
BotMinds.Memory.MaxPromptChars = 1200

########################################
# Rate limits
########################################

# BotMinds.Limits.ProximityRadius
#     Description: How close a bot must be to answer overheard chat. Direct
#                  answers to someone who addressed it ignore this.
#     Default:     40.0
BotMinds.Limits.ProximityRadius = 40.0

# BotMinds.Limits.PerBotCooldownSec
#     Description: Quiet time between a bot's unprompted lines. A direct answer
#                  ignores it, so a bot never goes mute mid-conversation.
#     Default:     12
BotMinds.Limits.PerBotCooldownSec = 12

# BotMinds.Limits.PerScopeCooldownSec
#     Description: Quiet time between unprompted lines in one conversation scope
#                  (local listener, party, guild or channel). Direct answers
#                  ignore it.
#     Default:     15
BotMinds.Limits.PerScopeCooldownSec = 15

# BotMinds.Limits.MaxCallsPerScopePerMinute
#     Description: Maximum unprompted calls in one conversation scope per minute.
#                  Direct answers ignore it. 0 disables this limit.
#     Default:     8
BotMinds.Limits.MaxCallsPerScopePerMinute = 8

# BotMinds.Limits.MaxConcurrentCalls
#     Description: How many API calls may be in flight at once. Anything asked to
#                  speak while the slots are full stays quiet.
#     Default:     3
BotMinds.Limits.MaxConcurrentCalls = 3

# BotMinds.Limits.MaxCallsPerMinute
#     Description: Ceiling on API calls in any one minute, counting every line
#                  every bot speaks. The safety rail on your bill: whatever
#                  happens in game, spend cannot exceed this. 0 disables it.
#     Default:     60
BotMinds.Limits.MaxCallsPerMinute = 60

# BotMinds.Limits.DisableRepliesInCombat
#     Default:     1
BotMinds.Limits.DisableRepliesInCombat = 1

########################################
# Repetition protection
########################################

# Recent lines are compared by content words and character trigrams. The scope
# history also rejects repeated three-word openers, which stops a room full of
# different bots all beginning with the same catchphrase. Set both history sizes
# to 0 to disable this guard.
BotMinds.Repetition.BotHistorySize = 12
BotMinds.Repetition.ScopeHistorySize = 30
BotMinds.Repetition.SimilarityThreshold = 0.72
BotMinds.Repetition.WindowSec = 1800
BotMinds.Repetition.OpenerHistorySize = 8

########################################
# Ambient chatter
#
# Unprompted remarks about whatever is around the bot, only where a real player
# can hear them. Timing is coordinated per audible scene, so adding more bots to
# an inn, party or channel adds possible speakers without multiplying the chatter
# rate. A failed chance roll retries on the next 30-second coordinator tick; a
# successful line starts the full random interval. When combat replies are
# disabled and every possible speaker is fighting, the interval pauses and
# resumes with its remaining time after combat.
########################################

# Who a bot needs nearby before it speaks unprompted is BotMinds.SayDistance,
# the same earshot that decides whether it can hear you. Bots in your party are
# exempt and chatter from any distance, because party chat reaches you wherever
# they are, exactly as it does when they answer you.
BotMinds.Ambient.Enable         = 1
BotMinds.Ambient.Chance         = 25
BotMinds.Ambient.MinIntervalSec = 120
BotMinds.Ambient.MaxIntervalSec = 600

# Ambient numbered-channel destinations. Party chat still takes priority when a
# real player is grouped with the bot. Otherwise Say and every enabled channel
# that both a bot and a real player have joined are eligible destinations.
# Numbered channels are off by default because their audience and call volume can
# be much larger than local Say.
BotMinds.Ambient.Channel.General = 0
BotMinds.Ambient.Channel.Trade = 0
BotMinds.Ambient.Channel.LookingForGroup = 0
BotMinds.Ambient.Channel.GuildRecruitment = 0

########################################
# Event reactions
#
# Chances are per event, rolled once before any bot is picked.
########################################

BotMinds.Events.Enable      = 1
BotMinds.Events.EnableGuild = 1
BotMinds.Events.Distance    = 40.0

# BotMinds.Events.MaxBots
#     Description: Most bots that may react to one event.
#     Default:     1
BotMinds.Events.MaxBots = 1

BotMinds.Events.Chance.Kill    = 1
BotMinds.Events.Chance.PvPKill = 15
BotMinds.Events.Chance.Death   = 25
BotMinds.Events.Chance.Quest   = 20
BotMinds.Events.Chance.Spell   = 2
BotMinds.Events.Chance.Duel    = 25
BotMinds.Events.Chance.LevelUp = 60
BotMinds.Events.Chance.Achievement = 75
BotMinds.Events.Chance.ObjectUse = 10

# BotMinds.Events.Chance.Loot
#     Description: Only rare quality and above is ever considered.
#     Default:     15
BotMinds.Events.Chance.Loot = 15

BotMinds.Events.Chance.GuildEpicGear = 80
BotMinds.Events.Chance.GuildRareGear = 30
BotMinds.Events.Chance.GuildLevelUp  = 50
BotMinds.Events.Chance.GuildMember   = 60
BotMinds.Events.Chance.GuildLogin = 60
BotMinds.Events.Chance.GuildPromotion = 25
BotMinds.Events.Chance.GuildDemotion = 5
BotMinds.Events.Chance.GuildAchievement = 75
BotMinds.Events.Chance.DungeonComplete = 85

########################################
# World life
#
# Party bots notice changes in the shared journey, recognize people they know,
# build history with one another and sometimes use an ordinary gesture instead
# of spending a provider call on another line. Journey events are coordinated
# per party, so only one bot reacts.
########################################

BotMinds.WorldLife.Enable = 1
BotMinds.WorldLife.Chance.Zone = 35
BotMinds.WorldLife.Chance.Town = 45
BotMinds.WorldLife.Chance.Dungeon = 75
BotMinds.WorldLife.Chance.Boss = 90

# Suppresses a second travel remark when a map, zone and town transition happen
# together. It does not affect boss, quest or ordinary ambient reactions.
BotMinds.WorldLife.JourneyCooldownSec = 120

# A bot only greets somebody as a returning acquaintance when it has a stored
# relationship and that relationship has not been touched for this long.
BotMinds.WorldLife.Reunion.Chance = 70
BotMinds.WorldLife.Reunion.MinAbsenceSec = 21600

# Small mutual affinity gain between bots after meaningful shared successes.
# 0 keeps bot-to-bot relationships entirely model-driven.
BotMinds.WorldLife.SharedExperienceAffinity = 0.01

# Chance that a due ambient scene becomes a context-appropriate gesture rather
# than an LLM line. This uses the normal ambient interval and emote cooldown.
BotMinds.WorldLife.IdleGestureChance = 20

########################################
# Player emote reactions
########################################

# A real player must target the bot with a text emote. Mirror and counter
# reactions are normal in-game emotes and do not call the provider; Speak does.
BotMinds.EmoteReaction.Enable = 1
BotMinds.EmoteReaction.Chance = 60
BotMinds.EmoteReaction.MirrorWeight = 55
BotMinds.EmoteReaction.CounterWeight = 30
BotMinds.EmoteReaction.SpeakWeight = 15
BotMinds.EmoteReaction.CooldownSec = 20

########################################
# Actions
#
# What bots will actually do, not just say. Buffs and out-of-combat heals for
# anyone who asks; gold if they like you enough; follow and wait for bots you
# have grouped with.
#
# A bot is told what it can really do before it answers, so it only offers real
# things and refuses in its own words.
########################################

BotMinds.Actions.Enable = 1

# BotMinds.Actions.MaxAttempts
#     Description: A cast can fail because the bot was walking or standing up, so
#                  actions are retried. This is how many goes they get.
#     Default:     3
BotMinds.Actions.MaxAttempts = 3

# BotMinds.Actions.Gold.MinAffinity
#     Description: How warmly a bot must feel about you, on a -1 to 1 scale,
#                  before it will part with coin. Strangers sit near 0.
#     Default:     0.25
BotMinds.Actions.Gold.MinAffinity = 0.25

# BotMinds.Actions.Gold.MaxCopper
#     Description: Hard ceiling on a single gift, in copper. 5000 is 50 silver.
#                  0 stops bots giving money at all.
#
#                  This is a deliberate design number, not a fraction of the
#                  bot's purse: bots are created holding hundreds of gold, so
#                  "whatever it can spare" would hand a low level player a
#                  fortune and wreck your economy.
#     Default:     5000
BotMinds.Actions.Gold.MaxCopper = 5000

# BotMinds.Actions.Gold.CopperPerLevel
#     Description: Scales the ceiling by the giving bot's level, so a level 8 bot
#                  is not as generous as a level 60 one. 100 is 1 silver a level.
#     Default:     100
BotMinds.Actions.Gold.CopperPerLevel = 100

# BotMinds.Actions.Gold.CooldownSec
#     Description: How long before the same bot will give you money again.
#                  86400 is once a day. Survives a restart.
#     Default:     86400
BotMinds.Actions.Gold.CooldownSec = 86400

# BotMinds.Actions.Unprompted.Chance
#     Description: Chance every 30 seconds that a nearby capable bot casts one
#                  genuinely missing buff on a real player. The cast is direct and
#                  does not spend an LLM request. Choices are class- and
#                  context-aware: useful long buffs win, mutually exclusive
#                  blessings are respected, and aquatic/emergency spells are only
#                  used when relevant. 0 disables passerby buffs.
#     Default:     20
BotMinds.Actions.Unprompted.Chance = 20

# BotMinds.Actions.Unprompted.CooldownSec
#     Description: How long before anyone gives the same real player another
#                  unasked buff, so it stays a nice surprise.
#     Default:     900
BotMinds.Actions.Unprompted.CooldownSec = 900

########################################
# Helpful recovery
########################################

# A nearby friendly healer bot may resurrect a dead real player or heal a badly
# hurt one after combat. These casts are direct and use no LLM request. Existing
# resurrection offers, battlegrounds and anyone still fighting are left alone.

# BotMinds.Recovery.Enable
#     Default:     1
BotMinds.Recovery.Enable = 1

# BotMinds.Recovery.ScanIntervalSec
#     Description: How often nearby real players are checked. This timer is
#                  independent of ambient chatter and passerby buffs.
#     Default:     10
BotMinds.Recovery.ScanIntervalSec = 10

# BotMinds.Recovery.Distance
#     Description: Furthest distance in yards from healer to player.
#     Default:     30.0
BotMinds.Recovery.Distance = 30.0

# BotMinds.Recovery.ResurrectChance
#     Description: Chance on each scan that an eligible dead player receives a
#                  resurrection offer. 0 disables spontaneous resurrection.
#     Default:     75
BotMinds.Recovery.ResurrectChance = 75

# BotMinds.Recovery.HealChance
#     Description: Chance on each scan that an eligible badly hurt player is
#                  healed. 0 disables spontaneous post-combat healing.
#     Default:     35
BotMinds.Recovery.HealChance = 35

# BotMinds.Recovery.HealBelowPct
#     Description: A living player must be below this health percentage.
#     Default:     55
BotMinds.Recovery.HealBelowPct = 55

# BotMinds.Recovery.CooldownSec
#     Description: Quiet time after somebody receives either kind of recovery.
#     Default:     300
BotMinds.Recovery.CooldownSec = 300

########################################
# Social reciprocity
########################################

# A bot notices an effective heal, direct positive spell or completed
# resurrection from a real player. It remembers the help in its relationship,
# waits until combat is over, then /thanks and may add one short line. A group
# buff produces at most one visible response at a time instead of a chorus.

# BotMinds.Reciprocity.Enable
#     Default:     1
BotMinds.Reciprocity.Enable = 1

# BotMinds.Reciprocity.AffinityGain
#     Description: Relationship increase for one credited act of help.
#     Default:     0.02
BotMinds.Reciprocity.AffinityGain = 0.02

# BotMinds.Reciprocity.CooldownSec
#     Description: How often the same bot credits the same player. This also
#                  prevents healing-over-time ticks from producing repeated thanks.
#     Default:     300
BotMinds.Reciprocity.CooldownSec = 300

# BotMinds.Reciprocity.SpeakChance
#     Description: Chance that /thank also gets a short local line. No provider
#                  call is made. 0 leaves the normal text emote only.
#     Default:     35
BotMinds.Reciprocity.SpeakChance = 35

# BotMinds.Conversation.HoldStillSec
#     Description: How long a bot stands still and faces you after accepting a
#                  direct local turn, in seconds. The hold begins while the reply
#                  is generated and refreshes when it is spoken, so a conversation
#                  keeps the bot planted until it goes quiet.
#
#                  A real player stops walking to type. Without this a bot answers
#                  you and jogs off mid-sentence, and you end up chasing it to stay
#                  inside earshot. Combat always wins, and bots in your group are
#                  left alone since they follow you anyway. 0 disables it.
#     Default:     8
BotMinds.Conversation.HoldStillSec = 8

# BotMinds.Emote.CooldownSec
#     Description: Least time between one bot's gestures, in seconds. 0 stops bots
#                  emoting at all.
#
#                  A bot may add a wave, laugh, nod, shrug, thank, cheer, salute,
#                  bow or sigh to a line. The prompt asks for restraint, and this
#                  enforces it: an emote attached to every greeting stops meaning
#                  anything, so the occasional one is the whole point.
#     Default:     180
BotMinds.Emote.CooldownSec = 180

########################################
# Presentation
########################################

# BotMinds.Typing.Enable
#     Description: Hold a finished line back as if the bot were typing it.
#     Default:     0
BotMinds.Typing.Enable         = 0
BotMinds.Typing.BaseDelayMs    = 1000
BotMinds.Typing.DelayPerCharMs = 25
BotMinds.Typing.MaxDelayMs     = 8000

########################################
# Housekeeping
########################################

# BotMinds.SaveIntervalMinutes
#     Description: How often personas and relationships are written back.
#                  Memories are written immediately and ignore this.
#     Default:     10
BotMinds.SaveIntervalMinutes = 10

# BotMinds.BlacklistCommands
#     Description: Chat that is a playerbot command or addon traffic rather than
#                  conversation. Matched as a prefix on the message.
BotMinds.BlacklistCommands = autogear,talents,reset botAI,summon,release,revive,leave,attack,follow,flee,stay,runaway,grind,disperse,give leader,spells,cast ,quests,accept,drop,talk,reset,ss ,trainer,rti,rtsc,do ,ll ,e ,ue ,nc ,open,destroy,s ,b ,bank,gb ,u ,co ,ELVUI_VERSIONCHK,Asked,DPSMate_,LibGroupTalents,BLT,oRA3,Skada,HealBot,hbComms,questie,pfQuest,DBMv4-Ver,BWVQ3,add,remove,reset ai,report,state,help,log,stats,tank,offtank,healer,cc ,damage,boost,passive,defensive,aggressive,guard,free,assist,pet,stance,formation,rpg,emote,cheer,applaud,drink,eat,dance,attackers,reset instances,home,zone,who ,pos ,tele,loot,quest,travel,teleport,homebind,unfollow,invite,uninvite,join,leader,ready,save,update,reset talents,gear,trade,mail,ah ,ahscan,ahbid,ahbuy,ahsell,ahcancel,bag,repair,vendor,train,reset spells,learn,unlearn,uncast,use ,move,go ,look,stop,turn,face,wait,party,followleader,stayleader,moveleader,info,distance,debug,reset path,reset state,reset all,reset dungeon,reset raid,zone info,LHC40,RECOUNT,GTFO_v,Altoholic,DS_,DataStore
